{% extends 'base.html.twig' %}

{% block title %}Customer List{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Customer index</h1>

        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th scope="col">CustomerId</th>
                    <th scope="col">FirstName</th>
                    <th scope="col">LastName</th>
                    <th scope="col">Email</th>
                    <th scope="col">PhoneNumber</th>
                    <th scope="col">City</th>
                    <th scope="col">Street</th>
                    <th scope="col">PostalCode</th>
                    <th scope="col">Country</th>
                    <th scope="col">actions</th>
                </tr>
            </thead>
            <tbody>
            {% for customer in customers %}
                <tr>
                    <td>{{ customer.customerId }}</td>
                    <td>{{ customer.firstName }}</td>
                    <td>{{ customer.lastName }}</td>
                    <td>{{ customer.email }}</td>
                    <td>{{ customer.phoneNumber }}</td>
                    <td>{{ customer.city }}</td>
                    <td>{{ customer.street }}</td>
                    <td>{{ customer.postalCode }}</td>
                    <td>{{ customer.country }}</td>
                    <td>
                        <a href="{{ path('app_customer_show', {'customerId': customer.customerId}) }}" class="btn btn-sm btn-info me-1">show</a>
                        <a href="{{ path('app_customer_edit', {'customerId': customer.customerId}) }}" class="btn btn-sm btn-warning">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10" class="text-capitalize text-center text-muted">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-3">
            <a href="{{ path('app_customer_new') }}" class="btn btn-primary">Create new</a>
        </div>
    </div>
{% endblock %}
